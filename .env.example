IMVU_USERNAME=Ramsei
IMVU_PASSWORD=
IMVU_ROOM_ID=330286535-177
# Optional comma-separated startup rooms; overrides the single startup room.
IMVU_ROOM_IDS=
# Your public HTTPS hosting URL, without /stream.mp3 (used by !radio).
PUBLIC_BASE_URL=
# Enable only when stdin is attached to the running foreground bot process.
TERMINAL_CONTROL=0
PORT=3000
# Optional external PostgreSQL connection string, entered privately in Bothost.
# Without this, rebuilds lose the saved login, admins and blocks.
DATABASE_URL=
STATE_NAMESPACE=ramsei-330286535-177
# Optional, only if IMVU requests a security code. Remove expired codes.
IMVU_2FA_CODE=
# Local fallback only. Bothost does not preserve this across rebuilds.
SESSION_PATH=/app/data/imvu-session.json
# Owner is Ramzy, ID 214900673, fixed in permissions.py.
# Optional first-start admins. Leave empty and use !addadmin from the owner account.
ADMIN_IDS=
PERMISSIONS_PATH=/app/data/permissions.json
WELCOME_MESSAGE=نورت الروم يا {name}! 😎💛 أنا رامسي البوت، للمزيكا !play واسم الأغنية، وللعب !game 🎲
# Optional real AI chat: create your own key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_MAX_CALLS_PER_HOUR=60
