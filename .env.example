IMVU_USERNAME=Ramsei
IMVU_PASSWORD=
IMVU_ROOM_ID=330286535-177
# Optional first-start extra rooms. Main room always stays; saved rooms take priority.
IMVU_ROOM_IDS=
# Your public HTTPS hosting URL, without /stream.mp3 (used by !radio).
PUBLIC_BASE_URL=
# Enable local botctl.py shell controls and optional foreground stdin controls.
TERMINAL_CONTROL=0
PORT=3000
# Optional external PostgreSQL connection string, entered privately in Bothost.
# Optional alternative to a persistent /app/data/ramsei volume.
DATABASE_URL=
STATE_NAMESPACE=ramsei-330286535-177
# Optional, only if IMVU requests a security code. Remove expired codes.
IMVU_2FA_CODE=
# Keep these files on the host's persistent /app/data volume, never /tmp.
SESSION_PATH=/app/data/ramsei/imvu-session.json
# Owner is Ramzy, ID 214900673, fixed in permissions.py.
# Optional first-start admins. Leave empty and use !addadmin from the owner account.
ADMIN_IDS=
PERMISSIONS_PATH=/app/data/ramsei/permissions.json
WELCOME_MESSAGE=نورت الروم يا {name}! 😎💛 أنا رامسي البوت، للمزيكا !play واسم الأغنية، وللعب !game 🎲
# Optional AI chat. Groq is the default; keep keys private in host variables.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Alternative provider: set AI_PROVIDER=gemini to use these fields.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_MAX_CALLS_PER_HOUR=60
# Optional private Telegram chat bridge. Token belongs in host secrets only.
TELEGRAM_BOT_TOKEN=
# Positive numeric Telegram account ID, pinned to the owner (never a group ID).
TELEGRAM_OWNER_ID=
TELEGRAM_STATE_PATH=/app/data/ramsei/telegram-bridge.json
TELEGRAM_TIMEZONE=Asia/Yekaterinburg
